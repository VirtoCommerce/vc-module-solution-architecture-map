<?xml version="1.0" encoding="utf-8"?>
<module>
  <id>VirtoCommerce.SolutionArchitectureMap</id>
  <version>3.1000.0</version>
  <version-tag></version-tag>

  <platformVersion>3.1039.0</platformVersion>
  <dependencies>
    <dependency id="VirtoCommerce.Search" version="3.1004.1" />
  </dependencies>

  <title>Solution Architecture Map</title>
  <description>Interactive solution architecture map to the platform App Menu. It visualizes how a customer's solution is deployed across Virto Cloud and Virto Commerce as an explorable, animated "iceberg".</description>

  <authors>
    <author>Oleg Zhuk</author>
  </authors>
  <owners>
    <owner>Virto Commerce</owner>
  </owners>

  <projectUrl>https://github.com/VirtoCommerce/vc-module-solution-architecture-map</projectUrl>
  <iconUrl>Modules/$(VirtoCommerce.SolutionArchitectureMap)/Content/logo.svg</iconUrl>
  <requireLicenseAcceptance>false</requireLicenseAcceptance>

  <assemblyFile>VirtoCommerce.SolutionArchitectureMap.Web.dll</assemblyFile>
  <moduleType>VirtoCommerce.SolutionArchitectureMap.Web.Module, VirtoCommerce.SolutionArchitectureMap.Web</moduleType>

  <releaseNotes>First version.</releaseNotes>
  <copyright>Copyright © 2026 Virto Commerce. All rights reserved</copyright>
  <tags>extension module</tags>
  <useFullTypeNameInSwagger>false</useFullTypeNameInSwagger>

  <!-- Standalone Vue app surfaced in the platform App Menu (permission-gated). -->
  <apps>
    <app id="solution-architecture-map">
      <title>Solution Architecture Map</title>
      <description>Interactive map of your solution across Virto Cloud and Virto Commerce.</description>
      <iconUrl>/modules/$(VirtoCommerce.SolutionArchitectureMap)/Content/logo.svg</iconUrl>
      <permission>solution-architecture-map:access</permission>
      <supportEmbeddedMode>true</supportEmbeddedMode>
    </app>
  </apps>
</module>
